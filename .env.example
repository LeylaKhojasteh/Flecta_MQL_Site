# Copy this file to .env and fill in the real values.
# Never commit .env or an email password to Git.

# Gmail SMTP: use a Google App Password, not the normal account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=FLECTA <your-email@gmail.com>
SECRET_KEY=replace-with-a-long-random-secret-key
