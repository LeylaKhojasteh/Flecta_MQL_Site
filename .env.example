# Copy this file to .env and fill in the real values.
# Never commit .env or real passwords to Git.

SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False

# --- Database -----------------------------------------------------------
# Vercel uses this on Supabase:
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Classic MySQL host (flectasite.setting.prod):
DB_NAME=flectamq_flecta
DB_USER=flectamq_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=3306

# --- Email --------------------------------------------------------------
EMAIL_HOST=flectamql.ir
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=manager@flectamql.ir
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=FLECTA MQL <manager@flectamql.ir>
CONTACT_RECIPIENT_EMAIL=manager@flectamql.ir

# --- Supabase Storage (optional, permanent media) -----------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=media
SUPABASE_STORAGE_ACCESS_KEY=replace-me
SUPABASE_STORAGE_SECRET_KEY=replace-me
SUPABASE_S3_REGION=eu-west-1
# SUPABASE_S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/media/
